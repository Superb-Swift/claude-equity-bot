# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual Environment
venv/

# Sensitive credentials — NEVER push these
.env
token.json

# OS clutter
.DS_Store
Thumbs.db

# Logs
*.log
# logs/* rather than logs/ so the two negations below are honoured: git
# cannot re-include a file whose parent DIRECTORY is excluded. (2026-09-17)
logs/*
# ...EXCEPT the two provenance ledgers: the readings behind ruled decision
# points (rulings.py) and the audit trail of every master close entered or
# repaired (enter_closes.py / repair_outcome_close.py). Neither holds account
# data. The master itself stays ignored (personal trading outcomes).
!logs/instrument_readings.json
!logs/outcome_close_repairs.log

# Microsoft Office temp/lock files
~$*.docx
~$*.xlsx
~$*.pptx
~$*.tsv
paste_today.tsv
backfill.tsv
all_may.tsv
tracker_with_registry.xlsx
near_miss_registry.xlsx
actionable_registry.xlsx
monitor_strip*.png

# Personal workflow docs (keep local, not in repo)
*.docx

# Tracking spreadsheet — contains personal trading outcomes
claude_equity_bot_tracker.xlsx
# WS2 runtime state — bot-maintained prior-signal cache (re-seedable from the
